+    _header_js = """
+        const params = new URLSearchParams(window.location.search);
+        const link = element.querySelector('[data-music-return]');
+        const toggle = element.querySelector('[data-theme-toggle]');
+        const requestedTheme = params.get('theme');
+        let storedTheme = null;
+        try { storedTheme = localStorage.getItem('bo-audio-theme'); } catch (_) {}
+        let theme = requestedTheme === 'light' || requestedTheme === 'dark'
+          ? requestedTheme
+          : storedTheme === 'light' ? 'light' : 'dark';
+        const target = params.get('music');
+        if (link && target) {
+          try {
+            const url = new URL(target);
+            const loopback = ['127.0.0.1', 'localhost', '::1', '[::1]'].includes(url.hostname);
+            if (url.protocol === 'http:' && loopback) link.href = url.href;
+          } catch (_) {}
+        }
+        const applyTheme = (next) => {
+          theme = next;
+          document.documentElement.dataset.boTheme = theme;
+          document.documentElement.style.colorScheme = theme;
+          try { localStorage.setItem('bo-audio-theme', theme); } catch (_) {}
+          if (toggle) {
+            const destination = theme === 'dark' ? 'light' : 'dark';
+            toggle.setAttribute('aria-label', `Switch to ${destination} mode`);
+            toggle.setAttribute('title', `Switch to ${destination} mode`);
+          }
+          if (link) {
+            try { const url = new URL(link.href); url.searchParams.set('theme', theme); link.href = url.href; } catch (_) {}
+          }
+          const current = new URL(window.location.href);
+          if (current.searchParams.get('theme') !== theme) {
+            current.searchParams.set('theme', theme);
+            history.replaceState(history.state, '', current);
+          }
+        };
+        applyTheme(theme);
+        if (toggle) toggle.addEventListener('click', () => applyTheme(theme === 'dark' ? 'light' : 'dark'));
